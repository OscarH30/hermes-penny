# ─────────────────────────────────────────────────────────────────────
# Penny — environment
#
# You do NOT need to fill this in before talking to her.
#
# Onboarding connects her tools for you and wires them to this profile.
# This file only matters if you choose the direct-credential route instead
# of Composio — creating your own developer app at Intuit or Xero. She will
# tell you which values she needs, if any.
#
# Leaving every line blank is a perfectly normal, working setup.
# ─────────────────────────────────────────────────────────────────────

# Composio (recommended path)
COMPOSIO_API_KEY=

# QuickBooks Online — only if not using Composio
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=

# Xero — only if not using Composio
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Optional: an inbox Penny watches for forwarded receipts.
# Telegram photos work without this.
PENNY_RECEIPT_EMAIL=
