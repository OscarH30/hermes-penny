# ─────────────────────────────────────────────────────────────────────
# Penny — environment
#
# Everything here is OPTIONAL. If you connect QuickBooks or Xero through
# Composio (recommended), you do not need to fill in any credential below.
#
#   composio link quickbooks      # or: composio link xero
#
# The direct-credential route below means creating a developer app at Intuit
# or Xero. It works, but it is real effort. Composio is easier.
# ─────────────────────────────────────────────────────────────────────

# Composio (recommended path)
COMPOSIO_API_KEY=

# QuickBooks Online — only if not using Composio
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=

# Xero — only if not using Composio
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Optional: an inbox Penny watches for forwarded receipts.
# Telegram photos work without this.
PENNY_RECEIPT_EMAIL=
